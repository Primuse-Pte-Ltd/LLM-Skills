# ******************* OPENAI AND GEMINI HTTP *********************************
# Used by scripts/query_llms.py when the codex and gemini CLIs are absent.
# Copy this file to .env in the skill directory. Never commit .env.
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENAI_MODEL=gpt-5-nano
GEMINI_MODEL=gemini-3-flash-preview

# ******************* DASHBOARD ***********************************************
# Used by scripts/dashboard/server.py. Export it in the shell that starts the server.
AI_GATEWAY_API_KEY=
COUNCIL_PORT=8787

# ******************* OPENCODE COUNCIL ****************************************
# scripts/query_llms.py does not read this block.
# Copy these two lines into opencode/scripts/.env before an OpenCode run.
COUNCIL_MODELS=opencode/openai/gpt-4,opencode/anthropic/claude-3-5-sonnet,opencode/google/gemini-pro
CHAIRMAN_MODEL=opencode/anthropic/claude-3-5-sonnet
